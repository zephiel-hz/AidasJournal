{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "corepack pnpm install --frozen-lockfile"
      ]
    },
    "build": {
      "inputs": [
        {
          "step": "install"
        }
      ],
      "commands": [
        "PORT=3000 BASE_PATH=/ corepack pnpm --filter @workspace/aida run build"
      ]
    }
  },
  "deploy": {
    "startCommand": "corepack pnpm --filter @workspace/aida run serve -- --port $PORT",
    "variables": {
      "BASE_PATH": "/"
    }
  }
}
